# ─────────────────────────────────────────────────────────────────────────────
# NEXUS · Talent Hub environment
# Copy to `.env.local` (dev) or `.env.production.local` (build). Never commit real values.
# With every value left empty the app runs fully local: browser storage +
# the offline AI engine + LinkedIn assisted mode (this is the default).
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase web app (Firebase console → Project settings → Your apps → Web) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=csrm-nova-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=csrm-nova-dev
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Talent Hub data ──
# local (default): documents stay in this browser
# firestore: Google sign-in + live sync with the `talenthub` database (see firestore/README.md)
VITE_TALENT_BACKEND=local
VITE_TALENT_FIRESTORE_DB=talenthub
# Seed an EMPTY remote database with the demo data. Staging / demos only, never production.
VITE_TALENT_SEED_DEMO=false

# ── AI ──
# Gemini via Firebase AI Logic is used automatically when Firebase is configured;
# set to `offline` to force the built-in engine (it is always the fallback).
VITE_TALENT_AI=
VITE_GEMINI_MODEL=gemini-2.5-flash

# ── LinkedIn ──
# assisted (default): AI-built LinkedIn / Recruiter / X-ray searches + drafted messages you send yourself
# rsc: LinkedIn Recruiter System Connect (requires partner approval + a server-side proxy)
VITE_LINKEDIN_MODE=assisted
